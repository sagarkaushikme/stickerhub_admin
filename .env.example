# StickerHub admin panel environment variables
# Copy to `.env` for local dev, and set these in your host for production.

# Base URL of the StickerHub backend API (no trailing slash).
# Local dev default (if unset): http://localhost:4000/api
VITE_API_URL=https://api.stickerhub.in/api

# Public URL of the live storefront (used by the "Live Shop" link).
VITE_SHOP_URL=https://stickerhub.in
